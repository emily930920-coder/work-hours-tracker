PORT=3000
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production
NODE_ENV=development

# PostgreSQL 数据库连接（本地开发）
POSTGRES_URL=postgresql://localhost:5432/work_hours_tracker
# 或者使用完整的连接信息：
